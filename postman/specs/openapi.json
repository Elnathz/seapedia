        "/api/v1/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Authenticate and mint a Sanctum token",
                "description": "Mint a Sanctum token for non-SPA `/api/v1` consumers (§5.0). A\nsingle-role user (or admin) gets a role-scoped token immediately; a\nmulti-role user gets an unscoped token and must call `/role/select`.",
                "operationId": "a30aac1b7501f4f24e85306d1c4cec2d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Token issued (role-scoped or pending role selection)"
                    },
                    "422": {
                        "description": "Invalid credentials"
                    },
                    "429": {
                        "description": "Too many login attempts — throttled"
                    }
                }
            }
        },
        "/api/v1/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Revoke the current Sanctum token",
                "description": "Revoke the token used for this request (§5.0 \"logout invalidates\n     * token\" — proven by the same token being rejected on the next call).",
                "operationId": "b76198bd1b4798bab3a0b97a4f63b6a0",
                "responses": {
                    "200": {
                        "description": "Token revoked"
                    }
                },
                "security": [
